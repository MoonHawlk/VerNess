{
  "name": "verness",
  "version": "0.2.0",
  "private": true,
  "description": "VerNess — a model-agnostic, plugin-native AI execution harness built on the DeepSeek Harness (dsh) / Cordis substrate.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "start": "node scripts/verness.mjs",
    "web": "node scripts/verness.mjs web",
    "setup": "node scripts/verness.mjs setup",
    "doctor": "node scripts/verness.mjs doctor",
    "sync": "node scripts/verness.mjs sync",
    "graph": "node scripts/verness.mjs graph",
    "test": "node --test \"scripts/test/*.test.mjs\" \"packages/*/test/*.test.ts\"",
    "typecheck": "tsc -p packages/contracts",
    "model:up": "node scripts/model.mjs up",
    "model:stats": "node scripts/model.mjs stats",
    "model:down": "node scripts/model.mjs down"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3"
  }
}
