// FiNess setup file — the one place for day-to-day adjustments.
// JSON with // comments and trailing commas allowed. Every field is optional:
// anything omitted falls back to the defaults in scripts/finess.mjs.
//
//   ./turn_on.sh            (macOS/Linux)      .\turn_on.ps1        (Windows)
//   ./turn_on.sh setup      first-time install / repair
//   ./turn_on.sh doctor     what is installed, what is missing
//   ./turn_on.sh "task"     one-shot task
//
// After changing this file, `./turn_on.sh sync` regenerates
// profiles/<name>/cordis.patch.yml. `start` and `run` sync automatically.
{
  // ---------------------------------------------------------------- substrate
  "substrate": {
    // Pinned dsh version. Must match the upstream submodule tag (ADR-0002).
    "version": "0.1.7-rc.2",
    "pnpmVersion": "11.7.0",
  },

  // ------------------------------------------------------------------ profile
  "profile": {
    "name": "finess",
    // Template the profile is created from: headless (one-shot tasks, the
    // default) | web (browser UI) | acp | sdk. Changing this needs a re-run of
    // `setup`; an existing profile is never recreated.
    "template": "headless",
  },

  // -------------------------------------------------------------------- model
  // A hand-declared OpenAI-compatible route. The engine (Ollama) ships native
  // builds for Windows/macOS/Linux and pulls GGUF weights straight from Hugging
  // Face, so `source` is the same string on every platform.
  //   ./turn_on.sh up | stats | down     lifecycle, telemetry, shutdown
  "model": {
    "engine": "ollama",
    // Hugging Face GGUF reference: hf.co/<repo>:<quant>. Check available quants at
    // https://huggingface.co/<repo> — only the quants published there are valid tags.
    // Ollama-registry names (e.g. "qwen3:0.6b") also work here.
    "source": "hf.co/Qwen/Qwen3-0.6B-GGUF:Q8_0",
    "route": "ollama-local",
    "displayName": "Qwen3 0.6B (local, Hugging Face GGUF)",
    // Must equal `source`: it is the name the engine serves it under.
    "id": "hf.co/Qwen/Qwen3-0.6B-GGUF:Q8_0",
    // How long the weights stay resident in RAM/VRAM after the last request.
    "keepAliveMinutes": 10,
    "autoInstallEngine": true,
    "baseURL": "http://127.0.0.1:11434/v1",
    "apiKeyEnv": "OLLAMA_API_KEY",
    // Any non-empty value: Ollama ignores bearer auth, but pi-ai demands a key.
    "apiKeyValue": "ollama-local-no-auth",
    "contextWindow": 32768,
    "maxTokens": 4096,
    // Set true only for models that expose thinking levels.
    "reasoning": false,
    "autoServe": true,
    "autoPull": true,
  },

  // Hosted models need nothing here: `/api use <provider> <model>` switches the
  // agent to any provider the route adapter ships (keys go in .env). See
  // docs/11-MODELS-AND-API.md.
  // Extra routes are for what that catalog lacks. Keys are route names; each
  // takes the same fields as `model` plus `api`. Only `apiKeyEnv` references are
  // stored here — never a key itself. Switch with "activeRoute" below.
  "extraRoutes": {},

  // Route the agent actually uses. Empty string = the `model` route above.
  "activeRoute": "",

  // ----------------------------------------------------------------- personas
  // Until the persona subsystem lands (M4), a persona is its identity text:
  // it is injected through the existing system-prompt seam. `tools` and
  // `skills` are recorded now and enforced from M4 on — they do nothing yet.
  "personas": {
    "active": "generalist",
    "definitions": {
      "generalist": {
        "prefix": "You are a careful engineering assistant working inside the FiNess harness.",
        "suffix": "State what you verified and what you assumed. Never claim a command succeeded unless you ran it.",
        "tools": { "allow": [], "deny": [] },
        "skills": [],
      },
    },
  },

  // --------------------------------------------------------------------- tips
  // Short standing guidance appended to the active persona's suffix. Keep them
  // few and concrete — every line costs tokens on every single turn.
  "tips": [
    "Working directory is the FiNess repo; upstream/ is a read-only submodule.",
    "Prefer small, verifiable steps over long plans.",
  ],

  // ---------------------------------------------------------------- decisions
  // The decision layer (ADR-0009): a System-1 model answering typed questions so
  // cheap computation narrows the problem before an LLM turn is spent.
  //
  //   ./turn_on.sh decision up | stats | down      lifecycle of the sidecar
  //   /decide <task>                               route a task, model vs rules
  //
  // `enabled` only turns on SHADOW logging: the rules still decide everything that
  // runs. Nothing the model says steers the harness until its measured calibration
  // beats the rule baseline (T-223) - zero-shot it scores near chance.
  // On since 2026-09-26 to accumulate the labelled set calibration needs; each REPL
  // turn waits on one decision call (~1 s CPU), or skips it if the sidecar is down.
  "decisions": {
    "enabled": true,
    "shadow": true,
    "baseURL": "http://127.0.0.1:8000",
    "apiKeyEnv": "LAYA_API_KEY",
    "timeoutMs": 20000,
    // pip install "laya[serve]" into this venv; `decision up` does it for you.
    "venv": ".finess/py",
    "checkpoint": "english",
  },

  // ---------------------------------------------------------------------- pet
  // The companion that greets you at boot with versions and workers (model engine,
  // decision sidecar, last loop/team run). `/pet` redraws it with fresh probes.
  // Set enabled to false to boot with the one-line banner; FINESS_NO_PET=1 does
  // the same for a single run. It only draws on a real terminal, never in a pipe.
  // animate (default true) lets her move; set it to false for a still drawing. It
  // is off anyway when NO_COLOR or CI is set or the terminal is too narrow for the
  // side-by-side layout.
  "pet": {
    "enabled": true,
    "name": "Ness",
  },

  // ----------------------------------------------------------------- settings
  "settings": {
    // Tool presentation: native (default) | ptc | both.
    "toolsMode": "native",
    // Extra plugin rows are generated from this list. `path` is a local package
    // installed into the profile; omit it for a published package. `surfaces`
    // (e.g. ["web"]) limits a row to profiles of those templates; `repoConfig`
    // passes the checkout path to the plugin as `config.repo`.
    "plugins": [
      { "id": "finess-spike", "package": "@finess/spike", "path": "packages/spike", "enabled": true },
      // The launcher's quick-tools as slash commands in the web UI's message bar (ADR-0011). Web
      // profile only; `repoConfig` gives it this checkout's path (profile copy only, never committed).
      { "id": "finess-commands", "package": "@finess/commands", "path": "packages/commands", "enabled": true, "surfaces": ["web"], "repoConfig": true },
    ],
    // Browser-UI bundles, added to the WEB profile only with `dsh plugin add` so their own patch
    // applies (a plain plugin row would skip it and also land in the headless profile).
    // dsh-web-all: task board, Git graph, pet, usage, session archive, skins, plugin manager, ...
    // It also brings remote-web-ui, ssh (off by default), update and a community-plugin market.
    "webBundles": ["@linxin666/dsh-web-all"],
    // pnpm 11 stops an install while any dependency's install script is undecided. Decide each one
    // here; false = never run it. These five come with dsh-web-all: cloudflared would download a
    // tunnel binary (remote access), ssh2/cpu-features compile native extras. Not needed locally.
    "allowBuilds": {
      "@google/genai": false,
      "cloudflared": false,
      "cpu-features": false,
      "protobufjs": false,
      "ssh2": false,
    },
    // Substrate packages our plugins import. These are LINKED to the running
    // runtime's own copy, never installed as a second copy — two copies break
    // every tool call (see docs/RUNBOOK.md, module-identity fault).
    "linkedSubstratePackages": ["@deepseek-ai/dsh-tools"],
  },
}
