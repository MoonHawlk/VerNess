# Reference clones (research only, never committed) — see docs/04-PROGRESS.md for clone commands
.refs/

# Dependencies & build output
node_modules/
dist/
# Build output only. A bare `lib/` also matched scripts/lib/, which silently kept every launcher
# module out of git and would have left a fresh clone unable to start.
/lib/
packages/*/lib/
*.tsbuildinfo

# Local config / secrets
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Logs & temp
*.log
.tmp/
verness-spike.log

# Engram generated artifacts (see docs/adr/0005-engram-knowledge-graph.md)
.engram/

# Launcher run state (pids, logs) — see scripts/model.mjs
.verness/
