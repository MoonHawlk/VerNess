# Copy to .env (gitignored) and fill in only the providers you use.
# The launcher loads it at startup; a variable already set in your shell wins.
#
# Find the exact variable for a provider with:   /api key <provider>
# List every provider and whether its key is set: /api
#
# <PROVIDER>_API_KEY=...
#
# Optional: a Hugging Face token, for gated repos in /models add and /models search.
# HF_TOKEN=...
