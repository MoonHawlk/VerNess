{
  "name": "@finess/client-ui-brand",
  "version": "0.0.1",
  "private": true,
  "description": "Browser brand for the web UI: the FiNess mark and name in the substrate's brand slots, and the tab title.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  }
}
